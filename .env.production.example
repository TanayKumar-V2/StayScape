# ─────────────────────────────────────────────────────────────────────────────
# StayScape — Production Environment Variables Template (.env.production.example)
#
# DO NOT COMMIT REAL CREDENTIALS.
# Use your hosting platform's secret manager (Render, Vercel, etc.) to set these.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# BACKEND API & WORKER ENVIRONMENT VARIABLES (Render Services)
# =============================================================================

# ── Runtime & Node Environment ──────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
PORT=4000
# Set to 'false' for API Web Service, 'true' for Background Worker Service
ENABLE_WORKERS=false
HSTS_ENABLED=true

# ── Web Origins, CORS & Cookie Domains ──────────────────────────────────────
# Canonical frontend origin (must be HTTPS in production)
WEB_ORIGIN=https://www.stayscape.example
# Optional comma-separated additional origins (e.g. preview/staging subdomains)
WEB_ORIGINS=https://stayscape.example,https://staging.stayscape.example
# Shared cookie domain for cross-subdomain authentication (leading dot covers subdomains)
COOKIE_DOMAIN=.stayscape.example
COOKIE_SECURE=true
# Client IPs/CIDRs trusted for X-Forwarded-For (Render uses standard reverse proxies)
TRUSTED_PROXIES=loopback

# ── Neon PostgreSQL Database ────────────────────────────────────────────────
# Pooled connection string with -pooler for runtime API & worker queries
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection string WITHOUT -pooler for migrations & administrative commands
DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Managed Redis / Valkey ──────────────────────────────────────────────────
# Internal private Redis URL provided by Render Key Value / managed service
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@red-sample-instance:6379

# ── JWT Authentication (Generate using: openssl rand -base64 36) ─────────────
# Must be at least 32 characters long
ACCESS_TOKEN_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHAR_CRYPTO_RANDOM_ACCESS_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHAR_CRYPTO_RANDOM_REFRESH_SECRET
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Cloudinary Media Storage ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay Payments & Webhooks ─────────────────────────────────────────────
# In production (APP_ENV=production), KEY_ID must begin with 'rzp_live_'
# In staging (APP_ENV=staging), KEY_ID begins with 'rzp_test_'
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
# Minimum 32 characters generated in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_production_webhook_secret_32_chars
# Optional previous webhook secret during zero-downtime secret rotation
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# ── Groq AI Engine ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_production_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=1

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# Only variables prefixed with NEXT_PUBLIC_ are bundled for the browser.
# =============================================================================
NEXT_PUBLIC_APP_URL=https://www.stayscape.example
NEXT_PUBLIC_API_URL=https://api.stayscape.example/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.stayscape.example
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_live_key_id

